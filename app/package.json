{
  "name": "@repo-memory/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "repo-memory": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "bench": "tsx src/bench.ts"
  },
  "dependencies": {
    "@repo-memory/shared": "workspace:*",
    "@repo-memory/storage": "workspace:*",
    "@repo-memory/graph": "workspace:*",
    "@repo-memory/ingestion": "workspace:*",
    "@repo-memory/analysis": "workspace:*",
    "@repo-memory/api": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0"
  }
}
