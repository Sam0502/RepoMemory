# PostgreSQL
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=repo_memory
PG_USER=repo_memory
PG_PASSWORD=repo-memory-password

# Embeddings (onnx | gemini | placeholder)
EMBEDDING_PROVIDER=onnx
# Model override per provider (onnx: all-MiniLM-L6-v2, gemini: text-embedding-004)
EMBEDDING_MODEL=
GEMINI_API_KEY=
EMBEDDING_CACHE_DIR=./models

# Analysis
ANALYSIS_BATCH_SIZE=5000

# Logging & metrics
PINO_LOG_LEVEL=info
METRICS_ENABLED=true

# API auth (optional) — when set, all /api/* + /metrics require
# Authorization: Bearer <token>. The frontend reads it from /config.js,
# which only serves the token on loopback. Set ALLOW_TOKEN_BOOTSTRAP=false
# to disable the bootstrap entirely.
REPO_MEMORY_API_TOKEN=
ALLOW_TOKEN_BOOTSTRAP=true

# Frontend CORS origin
CORS_ORIGIN=http://localhost:3000
